#!/usr/bin/env bash

files=()

while IFS= read -r file; do
  files+=("$file")
done < <(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '\.(py|pyi)$' || true
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

echo "Formatting staged Python files..."

uv run ruff check --fix "${files[@]}"
if [ "$?" -ne 0 ]; then
  echo "Ruff found an unfixable problem."
  exit 1
fi

uv run ruff format "${files[@]}"
if [ "$?" -ne 0 ]; then
  echo "Ruff format failed."
  exit 1
fi

git add -- "${files[@]}"

uv run ruff check "${files[@]}"
if [ "$?" -ne 0 ]; then
  echo "Ruff still reports a problem after formatting."
  exit 1
fi

echo "Automatic Ruff formatting passed."
