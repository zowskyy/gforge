{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotforge.dev/schemas/run-record.schema.json",
  "title": "GodotForge Hub Run Record",
  "description": "Folded state of one Hub run, derived from the append-only run-event store. Volatile metadata (timestamps, durations, temp paths, raw logs) never enters proofHash.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "state",
    "goal_hash",
    "manifest_hash",
    "plan_id",
    "plan_hash",
    "artifact_hash",
    "authorization",
    "engine",
    "validation",
    "proof_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "started",
        "authorized",
        "needs_validation",
        "finalized",
        "interrupted"
      ]
    },
    "goal_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_hash": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "mode",
        "plan_hash",
        "scope"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "explicit_cli",
            "human_interactive",
            "ci_token"
          ]
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "apply",
            "update",
            "rollback"
          ]
        }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "version",
        "flavor",
        "executable_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "flavor": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "mode",
        "status",
        "stages"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "import",
            "load",
            "boot",
            "full"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "fail",
            "inconclusive"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "status"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "proof_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
