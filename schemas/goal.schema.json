{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotforge.dev/schemas/goal.schema.json",
  "title": "GodotForge Hub Goal",
  "description": "User-facing goal document. Compiles deterministically into a CreatorManifest (schema_version 2 for 2D, 3 for 3D); the goal is never a second authority on behavior identity or version.",
  "type": "object",
  "required": [
    "schema_version",
    "game"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "game": {
      "type": "object",
      "required": [
        "name",
        "template"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 _-]{1,64}$"
        },
        "template": {
          "type": "string",
          "enum": ["2d-platformer-minimal", "3d-tactical-shooter"]
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "oneOf": [
        {
          "description": "2D platformer parameters",
          "properties": {
            "platformer_controller": {
              "type": "object",
              "properties": {
                "speed": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "jump_velocity": {
                  "type": "string",
                  "pattern": "^-[0-9]+\\.[0-9]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "3D tactical shooter parameters",
          "properties": {
            "enforcer": {
              "type": "object",
              "properties": {
                "health": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "armor": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "move_speed": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "sprint_multiplier": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                }
              },
              "additionalProperties": false
            },
            "scout": {
              "type": "object",
              "properties": {
                "health": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "armor": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "move_speed": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "sprint_multiplier": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                }
              },
              "additionalProperties": false
            },
            "fixer": {
              "type": "object",
              "properties": {
                "health": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "armor": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "move_speed": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                },
                "sprint_multiplier": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.?[0-9]*$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "renderer": {
      "type": "string",
      "enum": ["forward_plus", "mobile", "compatibility"]
    },
    "physics_3d": {
      "type": "object",
      "description": "Numeric fields are canonical decimal strings (e.g. \"9.8\"), matching every other numeric field in this schema and GoalSpec.as_dict()'s actual serialization — never a bare JSON number (see PATCH-0016-amendment.md's canonical numeric serialization contract).",
      "properties": {
        "gravity": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        },
        "floor_snap_length": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "input_map": {
      "type": "object",
      "properties": {
        "move_forward": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "move_backward": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "move_left": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "move_right": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "jump": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "sprint": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "aim": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "fire_primary": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "fire_secondary": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ability_1": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ability_2": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ability_ultimate": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "reload": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "interact": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "directory_structure": {
      "type": "object",
      "properties": {
        "scenes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scripts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "docs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "external_repos": {
      "type": "array",
      "items": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "weapons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "abilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "weapon_overrides": {
      "type": "object",
      "description": "Goal-tunable weapon stats, keyed by weapon id. Fields left unset keep the template's fixed default for that weapon.",
      "properties": {
        "rifle": { "$ref": "#/$defs/weaponOverride" },
        "shotgun": { "$ref": "#/$defs/weaponOverride" },
        "sniper": { "$ref": "#/$defs/weaponOverride" }
      },
      "additionalProperties": false
    },
    "ability_overrides": {
      "type": "object",
      "description": "Goal-tunable ability stats, keyed by ability id. Fields left unset keep the template's fixed default for that ability.",
      "properties": {
        "dash": { "$ref": "#/$defs/abilityOverride" },
        "shield": { "$ref": "#/$defs/abilityOverride" },
        "heal": { "$ref": "#/$defs/abilityOverride" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "weaponOverride": {
      "type": "object",
      "properties": {
        "damage": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        },
        "fire_rate": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        },
        "magazine_size": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "pellet_count": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "reload_time": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "abilityOverride": {
      "type": "object",
      "properties": {
        "cooldown": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        },
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        },
        "magnitude": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        },
        "radius": {
          "type": "string",
          "pattern": "^[0-9]+\\.?[0-9]*$"
        }
      },
      "additionalProperties": false
    }
  }
}